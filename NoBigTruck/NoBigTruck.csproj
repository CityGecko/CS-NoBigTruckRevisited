<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net35</TargetFramework>
		<AssemblyName>NoBigTruck</AssemblyName>
		<RootNamespace>NoBigTruck</RootNamespace>
		<Product>No Big Truck Revisited</Product>
		<Authors>MacSergey (original), CityGecko</Authors>
		<Copyright>MIT License - see LICENSE</Copyright>
		<Version>2.0.0</Version>
		<AssemblyVersion>2.0.0.0</AssemblyVersion>
		<FileVersion>2.0.0.0</FileVersion>
		<LangVersion>9.0</LangVersion>
		<Configurations>Debug;Release</Configurations>
		<Deterministic>false</Deterministic>
		<GenerateDocumentationFile>false</GenerateDocumentationFile>
		<!-- Override on the command line, e.g. -p:ManagedDLLPath="S:/Steam/steamapps/common/Cities_Skylines/Cities_Data/Managed" -->
		<ManagedDLLPath Condition="'$(ManagedDLLPath)' == ''">$(MSBuildProgramFiles32)\Steam\steamapps\common\Cities_Skylines\Cities_Data\Managed</ManagedDLLPath>
		<ModDirectory>$(LOCALAPPDATA)\Colossal Order\Cities_Skylines\Addons\Mods\NoBigTruckRevisited\</ModDirectory>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)' == 'Release'">
		<Optimize>true</Optimize>
		<DebugType>none</DebugType>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)' == 'Debug'">
		<Optimize>false</Optimize>
		<DebugType>none</DebugType>
		<DefineConstants>DEBUG</DefineConstants>
	</PropertyGroup>

	<ItemGroup>
		<Reference Include="Assembly-CSharp">
			<HintPath>$(ManagedDLLPath)\Assembly-CSharp.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="ColossalManaged">
			<HintPath>$(ManagedDLLPath)\ColossalManaged.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="ICities">
			<HintPath>$(ManagedDLLPath)\ICities.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="UnityEngine">
			<HintPath>$(ManagedDLLPath)\UnityEngine.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="System.Xml" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="CitiesHarmony.API" Version="2.2.0" />
	</ItemGroup>

	<ItemGroup>
		<None Remove="Properties\launchSettings.json" />
		<None Remove="Translations\**" />
	</ItemGroup>

	<!-- AlgernonCommons (MIT, git submodule at ..\AlgernonCommons) incl. its Harmony patcher base classes. -->
	<Import Project="..\AlgernonCommons\AlgernonCommonsPatchingShared.projitems" Label="Shared" />

	<!-- Copy the mod to the local mods folder: DLLs, translations (own + AlgernonCommons core texts), licenses. -->
	<Target Name="DeployToModDirectory" AfterTargets="Build">
		<ItemGroup>
			<ModFiles Include="$(TargetDir)*.dll" />
			<TranslationFiles Include="$(ProjectDir)Translations\*.csv" />
			<TranslationCoreFiles Include="$(ProjectDir)..\AlgernonCommons\Translations\*.csv" />
		</ItemGroup>
		<RemoveDir Directories="$(ModDirectory)" />
		<Copy SourceFiles="@(ModFiles)" DestinationFolder="$(ModDirectory)" />
		<Copy SourceFiles="@(TranslationFiles)" DestinationFolder="$(ModDirectory)Translations" />
		<Copy SourceFiles="@(TranslationCoreFiles)" DestinationFolder="$(ModDirectory)Translations\Core" />
		<Copy SourceFiles="$(ProjectDir)..\LICENSE" DestinationFiles="$(ModDirectory)LICENSE.txt" />
		<Copy SourceFiles="$(ProjectDir)..\AlgernonCommons\LICENSE.txt" DestinationFiles="$(ModDirectory)LICENSE-AlgernonCommons.txt" />
		<Message Importance="high" Text="No Big Truck Revisited deployed to $(ModDirectory)" />
	</Target>
</Project>
